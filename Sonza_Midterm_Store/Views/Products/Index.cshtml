@model IEnumerable<Sonza_Midterm_Store.Models.Product>

<div class="container mt-4">
    <h2 class="mb-3 text-primary">Products</h2>
    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="bi bi-plus-circle"></i> Add Product
    </a>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>₱@p.Price</td>
                <td>@p.Category</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning me-1">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger me-1">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@p.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-cart-plus"></i> Add to Cart
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
